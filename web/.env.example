# Local prototype. For a dashboard on Laptop 1 reading the Pi, replace the
# loopback host with the Pi's actual LAN address and restart Next.js.
CONTROLLER_API_URL=http://127.0.0.1:8080
# Traffic Lab stays on the presentation laptop. Configure its Go process with
# TRAFFIC_LAB_TARGET=http://<pi-LAN-address>:8088 to load the Pi's proxy.
TRAFFIC_LAB_URL=http://127.0.0.1:8091
# Same local secret as CONTROL_TOKEN on the Pi. Never prefix this with NEXT_PUBLIC_.
CONTROL_TOKEN=
