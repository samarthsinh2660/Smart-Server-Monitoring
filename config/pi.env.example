# Copy to config/pi.env on the Pi. Replace the documentation IPs with real LAN IPs.
CONTROLLER_ADDR=0.0.0.0:8080
APP_URL=http://192.0.2.11:8000
AGENT_URL=http://192.0.2.11:8081
STANDBY_APP_URL=http://192.0.2.12:8000
STANDBY_AGENT_URL=http://192.0.2.12:8081
SQLITE_PATH=data/monitor.sqlite3
MODEL_URL=http://127.0.0.1:8090
CPU_WARNING_PERCENT=60
CPU_ACTIVATE_PERCENT=70
CPU_HOLD_SECONDS=15
STANDBY_TIMEOUT_SECONDS=180
# First verify monitoring and Wi-Fi wake; then explicitly enable control.
SCALING_ENABLED=false
# Set false for an always-on standby (e.g. a Mac running Docker).
STANDBY_WAKE_ENABLED=true
STANDBY_MAC=00:00:00:00:00:00
WOL_BROADCAST=192.0.2.255
HAPROXY_SOCKET=/run/haproxy/admin.sock
# Generate a local secret, e.g. openssl rand -hex 32; use the same value in web/.env.local.
CONTROL_TOKEN=
# Both settings below are needed for validated AI activation. Leave false initially.
AI_SCALING_ENABLED=false
AI_SCALING_VALIDATED=false
# MODEL_CAPACITY_RPM must be a measured capacity for the configured workload.
